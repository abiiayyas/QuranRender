{
  "$schema": "https://schema.quranrender.app/template/v1.json",
  "id": "editorial",
  "version": "1.0.0",
  "name": "Editorial Split",
  "description": "Tata letak kolom asimetris 16:9 atau 9:16 dengan teks Arab dan terjemahan berdampingan seimbang.",
  "author": "QuranRender Team",
  "license": "CC0-1.0",
  "supported_ratios": ["16:9", "9:16"],
  "default_ratio": "16:9",
  "safe_area": {
    "16:9": { "top": 0.08, "bottom": 0.08, "left": 0.08, "right": 0.08 },
    "9:16": { "top": 0.08, "bottom": 0.14, "left": 0.10, "right": 0.10 }
  },
  "background": {
    "default_color": "#18181B",
    "dimmer_opacity": 0.40
  },
  "typography": {
    "ayah_font": "LPMQ IsepMisbah",
    "ayah_size_cw": 0.072,
    "ayah_color": "#FAFAFA",
    "translation_font": "Inter",
    "translation_size_cw": 0.038,
    "translation_color": "#A1A1AA",
    "translation_opacity": 0.90,
    "highlight_style": "smooth_fade"
  }
}
