{
  "$schema": "https://schema.quranrender.app/template/v1.json",
  "id": "kajian-side-panel",
  "version": "1.0.0",
  "name": "Kajian Side Panel",
  "description": "Video pembicara 70% di kiri; panel kanan 30% menampilkan surah, ayat aktif, dan terjemahan.",
  "author": "QuranRender Team",
  "license": "GPL-3.0-or-later",
  "categories": [
    "broadcast",
    "podcast"
  ],
  "supported_ratios": [
    "16:9"
  ],
  "default_ratio": "16:9",
  "safe_area": {
    "16:9": {
      "top": 0.08,
      "bottom": 0.08,
      "left": 0.08,
      "right": 0.08
    }
  },
  "layers": [
    {
      "id": "bg",
      "kind": "background",
      "visible": true,
      "properties": {
        "source_type": "media_or_color",
        "default_color": "#0B0C0E",
        "dimmer_opacity": 0.0,
        "dimmer_type": "solid",
        "dimmer_color": "#000000",
        "blur_radius": 0.0
      }
    },
    {
      "id": "panel",
      "kind": "shape_rect",
      "visible": true,
      "properties": {
        "x": 0.7,
        "y": 0.0,
        "w": 0.3,
        "h": 1.0,
        "fill": "#15171C",
        "stroke": "rgba(0, 0, 0, 0)",
        "stroke_width_cw": 0.0,
        "radius_cw": 0.0
      }
    },
    {
      "id": "surah_name",
      "kind": "surah_title",
      "visible": true,
      "properties": {
        "font_family": "Amiri",
        "font_style": "Regular",
        "font_size_cw": 0.03,
        "text_color": "#F4F5F7",
        "position_anchor": "top_center",
        "offset_y_ch": 0.155,
        "box": {
          "x": 0.71,
          "y": 0.06,
          "w": 0.27,
          "h": 0.12
        }
      }
    },
    {
      "id": "ayah",
      "kind": "ayah_text",
      "visible": true,
      "properties": {
        "font_family": "LPMQ",
        "font_style": "Regular",
        "font_size_cw": 0.04,
        "line_height_multiplier": 1.9,
        "text_color": "#F4F5F7",
        "highlight_style": "smooth_fade",
        "highlight_active_color": "#FFFFFF",
        "highlight_inactive_opacity": 0.7,
        "position_anchor": "center",
        "max_width_cw": 0.25,
        "box": {
          "x": 0.71,
          "y": 0.22,
          "w": 0.27,
          "h": 0.4
        }
      }
    },
    {
      "id": "translation",
      "kind": "translation_text",
      "visible": true,
      "properties": {
        "font_family": "Inter",
        "font_style": "Regular",
        "font_size_cw": 0.019,
        "line_height_multiplier": 1.45,
        "text_color": "#E5E7EB",
        "opacity": 0.88,
        "position_relative_to": "ayah",
        "margin_top_ch": 0.025,
        "max_width_cw": 0.25,
        "box": {
          "x": 0.71,
          "y": 0.64,
          "w": 0.27,
          "h": 0.26
        }
      }
    },
    {
      "id": "ref_badge",
      "kind": "reference_badge",
      "visible": true,
      "properties": {
        "font_family": "Inter",
        "font_style": "Medium",
        "font_size_cw": 0.032,
        "text_color": "#E5E7EB",
        "opacity": 0.65,
        "position_relative_to": "translation",
        "margin_top_ch": 0.018
      }
    },
    {
      "id": "qari_pill",
      "kind": "reciter_pill",
      "visible": false,
      "properties": {
        "font_family": "Inter",
        "font_size_cw": 0.034,
        "text_color": "#FFFFFF",
        "background_color": "rgba(8, 9, 12, 0.55)",
        "border_radius_cw": 0.02,
        "padding_cw": [
          0.008,
          0.025
        ],
        "position_anchor": "bottom_center",
        "offset_y_ch": 0.26
      }
    }
  ],
  "animations": {
    "transition_in": {
      "type": "fade",
      "duration_ticks": 15360,
      "easing": "ease_out"
    },
    "transition_out": {
      "type": "fade",
      "duration_ticks": 9600,
      "easing": "ease_in"
    },
    "karaoke": {
      "transition_duration_ticks": 3840,
      "easing": "ease_out"
    }
  }
}
