{
  "$schema": "https://schema.quranrender.app/template/v1.json",
  "id": "kartu-apung",
  "version": "1.0.0",
  "name": "Kartu Apung",
  "description": "Ayat dan terjemahan di dalam kartu translusen bersudut membulat.",
  "author": "QuranRender Team",
  "license": "GPL-3.0-or-later",
  "categories": [
    "modern",
    "clean"
  ],
  "supported_ratios": [
    "9:16",
    "4:5"
  ],
  "default_ratio": "9:16",
  "safe_area": {
    "9:16": {
      "top": 0.08,
      "bottom": 0.14,
      "left": 0.1,
      "right": 0.1
    },
    "4:5": {
      "top": 0.08,
      "bottom": 0.1,
      "left": 0.08,
      "right": 0.08
    }
  },
  "layers": [
    {
      "id": "bg",
      "kind": "background",
      "visible": true,
      "properties": {
        "source_type": "media_or_color",
        "default_color": "#2B2F3A",
        "dimmer_opacity": 0.35,
        "dimmer_type": "solid",
        "dimmer_color": "#0B0C10",
        "blur_radius": 0.0
      }
    },
    {
      "id": "card",
      "kind": "shape_rect",
      "visible": true,
      "properties": {
        "x": 0.07,
        "y": 0.2,
        "w": 0.86,
        "h": 0.6,
        "fill": "rgba(18, 20, 24, 0.62)",
        "stroke": "rgba(255, 255, 255, 0.14)",
        "stroke_width_cw": 0.002,
        "radius_cw": 0.04
      }
    },
    {
      "id": "surah_name",
      "kind": "surah_title",
      "visible": false,
      "properties": {
        "font_family": "Amiri",
        "font_style": "Regular",
        "font_size_cw": 0.065,
        "text_color": "#F4F5F7",
        "position_anchor": "top_center",
        "offset_y_ch": 0.155
      }
    },
    {
      "id": "ayah",
      "kind": "ayah_text",
      "visible": true,
      "properties": {
        "font_family": "LPMQ",
        "font_style": "Regular",
        "font_size_cw": 0.082,
        "line_height_multiplier": 1.95,
        "text_color": "#F4F5F7",
        "highlight_style": "underline",
        "highlight_active_color": "#FFFFFF",
        "highlight_inactive_opacity": 0.7,
        "position_anchor": "center",
        "max_width_cw": 0.68,
        "box": {
          "x": 0.1,
          "y": 0.22,
          "w": 0.8,
          "h": 0.56
        }
      }
    },
    {
      "id": "translation",
      "kind": "translation_text",
      "visible": true,
      "properties": {
        "font_family": "Inter",
        "font_style": "Regular",
        "font_size_cw": 0.04,
        "line_height_multiplier": 1.45,
        "text_color": "#E5E7EB",
        "opacity": 0.88,
        "position_relative_to": "ayah",
        "margin_top_ch": 0.025,
        "max_width_cw": 0.66
      }
    },
    {
      "id": "ref_badge",
      "kind": "reference_badge",
      "visible": true,
      "properties": {
        "font_family": "Inter",
        "font_style": "Medium",
        "font_size_cw": 0.032,
        "text_color": "#E5E7EB",
        "opacity": 0.65,
        "position_relative_to": "translation",
        "margin_top_ch": 0.018
      }
    },
    {
      "id": "qari_pill",
      "kind": "reciter_pill",
      "visible": false,
      "properties": {
        "font_family": "Inter",
        "font_size_cw": 0.034,
        "text_color": "#FFFFFF",
        "background_color": "rgba(8, 9, 12, 0.55)",
        "border_radius_cw": 0.02,
        "padding_cw": [
          0.008,
          0.025
        ],
        "position_anchor": "bottom_center",
        "offset_y_ch": 0.26
      }
    }
  ],
  "animations": {
    "transition_in": {
      "type": "fade",
      "duration_ticks": 15360,
      "easing": "ease_out"
    },
    "transition_out": {
      "type": "fade",
      "duration_ticks": 9600,
      "easing": "ease_in"
    },
    "karaoke": {
      "transition_duration_ticks": 3840,
      "easing": "ease_out"
    }
  }
}
