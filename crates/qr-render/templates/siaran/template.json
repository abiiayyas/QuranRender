{
  "$schema": "https://schema.quranrender.app/template/v1.json",
  "id": "siaran",
  "version": "1.0.0",
  "name": "Papan Siaran",
  "description": "Lower-third elegan untuk podcast, siaran langsung, atau video pengajian dengan panel bawah semi-transparan.",
  "author": "QuranRender Team",
  "license": "CC0-1.0",
  "supported_ratios": ["16:9"],
  "default_ratio": "16:9",
  "safe_area": {
    "16:9": { "top": 0.08, "bottom": 0.08, "left": 0.08, "right": 0.08 }
  },
  "background": {
    "default_color": "#09090B",
    "dimmer_opacity": 0.50
  },
  "typography": {
    "ayah_font": "LPMQ IsepMisbah",
    "ayah_size_cw": 0.065,
    "ayah_color": "#FFFFFF",
    "translation_font": "Inter",
    "translation_size_cw": 0.034,
    "translation_color": "#E4E4E7",
    "translation_opacity": 0.95,
    "highlight_style": "smooth_fade"
  }
}
