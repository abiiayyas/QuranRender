{
  "$schema": "https://schema.quranrender.app/template/v1.json",
  "id": "fokus",
  "version": "1.0.0",
  "name": "Fokus Vertikal",
  "description": "Dioptimalkan khusus untuk video layar penuh vertikal Shorts, Reels, dan TikTok dengan peredup gradien ganda.",
  "author": "QuranRender Team",
  "license": "CC0-1.0",
  "supported_ratios": ["9:16"],
  "default_ratio": "9:16",
  "safe_area": {
    "9:16": { "top": 0.10, "bottom": 0.16, "left": 0.10, "right": 0.12 }
  },
  "background": {
    "default_color": "#030712",
    "dimmer_opacity": 0.45
  },
  "typography": {
    "ayah_font": "LPMQ IsepMisbah",
    "ayah_size_cw": 0.082,
    "ayah_color": "#FFFFFF",
    "translation_font": "Inter",
    "translation_size_cw": 0.042,
    "translation_color": "#D1D5DB",
    "translation_opacity": 0.95,
    "highlight_style": "smooth_fade"
  }
}
