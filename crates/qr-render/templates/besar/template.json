{
  "$schema": "https://schema.quranrender.app/template/v1.json",
  "id": "besar",
  "version": "1.0.0",
  "name": "Besar (Hafalan)",
  "description": "Teks ayat sangat besar di tengah layar tanpa terjemahan, untuk hafalan dan tadabbur.",
  "author": "QuranRender Team",
  "license": "GPL-3.0-or-later",
  "categories": [
    "modern",
    "memorize"
  ],
  "supported_ratios": [
    "9:16",
    "1:1"
  ],
  "default_ratio": "9:16",
  "safe_area": {
    "9:16": {
      "top": 0.08,
      "bottom": 0.14,
      "left": 0.1,
      "right": 0.1
    },
    "1:1": {
      "top": 0.06,
      "bottom": 0.06,
      "left": 0.06,
      "right": 0.06
    }
  },
  "layers": [
    {
      "id": "bg",
      "kind": "background",
      "visible": true,
      "properties": {
        "source_type": "media_or_color",
        "default_color": "#101114",
        "dimmer_opacity": 0.0,
        "dimmer_type": "solid",
        "dimmer_color": "#000000",
        "blur_radius": 0.0
      }
    },
    {
      "id": "surah_name",
      "kind": "surah_title",
      "visible": false,
      "properties": {
        "font_family": "Amiri",
        "font_style": "Regular",
        "font_size_cw": 0.065,
        "text_color": "#F4F5F7",
        "position_anchor": "top_center",
        "offset_y_ch": 0.155
      }
    },
    {
      "id": "ayah",
      "kind": "ayah_text",
      "visible": true,
      "properties": {
        "font_family": "LPMQ",
        "font_style": "Regular",
        "font_size_cw": 0.135,
        "line_height_multiplier": 1.95,
        "text_color": "#F4F5F7",
        "highlight_style": "smooth_fade",
        "highlight_active_color": "#FFFFFF",
        "highlight_inactive_opacity": 0.5,
        "position_anchor": "center",
        "max_width_cw": 0.8
      }
    },
    {
      "id": "ref_badge",
      "kind": "reference_badge",
      "visible": true,
      "properties": {
        "font_family": "Inter",
        "font_style": "Medium",
        "font_size_cw": 0.032,
        "text_color": "#E5E7EB",
        "opacity": 0.65,
        "position_relative_to": "ayah",
        "margin_top_ch": 0.018
      }
    },
    {
      "id": "qari_pill",
      "kind": "reciter_pill",
      "visible": false,
      "properties": {
        "font_family": "Inter",
        "font_size_cw": 0.034,
        "text_color": "#FFFFFF",
        "background_color": "rgba(8, 9, 12, 0.55)",
        "border_radius_cw": 0.02,
        "padding_cw": [
          0.008,
          0.025
        ],
        "position_anchor": "bottom_center",
        "offset_y_ch": 0.26
      }
    }
  ],
  "animations": {
    "transition_in": {
      "type": "fade",
      "duration_ticks": 15360,
      "easing": "ease_out"
    },
    "transition_out": {
      "type": "fade",
      "duration_ticks": 9600,
      "easing": "ease_in"
    },
    "karaoke": {
      "transition_duration_ticks": 3840,
      "easing": "ease_out"
    }
  }
}
