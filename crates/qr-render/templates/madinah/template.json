{
  "$schema": "https://schema.quranrender.app/template/v1.json",
  "id": "madinah",
  "version": "1.0.0",
  "name": "Madinah Hijau",
  "description": "Hijau zaitun malam dengan bingkai garis ganda minimalis, tanpa elemen figuratif.",
  "author": "QuranRender Team",
  "license": "GPL-3.0-or-later",
  "categories": [
    "traditional",
    "classic"
  ],
  "supported_ratios": [
    "16:9",
    "1:1"
  ],
  "default_ratio": "16:9",
  "safe_area": {
    "16:9": {
      "top": 0.08,
      "bottom": 0.08,
      "left": 0.08,
      "right": 0.08
    },
    "1:1": {
      "top": 0.06,
      "bottom": 0.06,
      "left": 0.06,
      "right": 0.06
    }
  },
  "layers": [
    {
      "id": "bg",
      "kind": "background",
      "visible": true,
      "properties": {
        "source_type": "media_or_color",
        "default_color": "#1F2B1A",
        "dimmer_opacity": 0.0,
        "dimmer_type": "solid",
        "dimmer_color": "#000000",
        "blur_radius": 0.0
      }
    },
    {
      "id": "frame_outer",
      "kind": "shape_rect",
      "visible": true,
      "properties": {
        "x": 0.03,
        "y": 0.045,
        "w": 0.94,
        "h": 0.91,
        "fill": "rgba(0, 0, 0, 0)",
        "stroke": "rgba(230, 198, 135, 0.85)",
        "stroke_width_cw": 0.003,
        "radius_cw": 0.0
      }
    },
    {
      "id": "frame_inner",
      "kind": "shape_rect",
      "visible": true,
      "properties": {
        "x": 0.045,
        "y": 0.075,
        "w": 0.91,
        "h": 0.85,
        "fill": "rgba(0, 0, 0, 0)",
        "stroke": "rgba(230, 198, 135, 0.45)",
        "stroke_width_cw": 0.0015,
        "radius_cw": 0.0
      }
    },
    {
      "id": "surah_name",
      "kind": "surah_title",
      "visible": false,
      "properties": {
        "font_family": "Amiri",
        "font_style": "Regular",
        "font_size_cw": 0.065,
        "text_color": "#E6C687",
        "position_anchor": "top_center",
        "offset_y_ch": 0.155
      }
    },
    {
      "id": "ayah",
      "kind": "ayah_text",
      "visible": true,
      "properties": {
        "font_family": "LPMQ",
        "font_style": "Regular",
        "font_size_cw": 0.092,
        "line_height_multiplier": 1.95,
        "text_color": "#E6C687",
        "text_shadow": {
          "color": "rgba(0, 0, 0, 0.45)",
          "blur": 14.0,
          "offset_x": 0.0,
          "offset_y": 1.5
        },
        "highlight_style": "smooth_fade",
        "highlight_active_color": "#FFE9B0",
        "highlight_inactive_opacity": 0.7,
        "position_anchor": "center",
        "max_width_cw": 0.8
      }
    },
    {
      "id": "translation",
      "kind": "translation_text",
      "visible": true,
      "properties": {
        "font_family": "Inter",
        "font_style": "Regular",
        "font_size_cw": 0.04,
        "line_height_multiplier": 1.45,
        "text_color": "#F4EFE0",
        "opacity": 0.88,
        "position_relative_to": "ayah",
        "margin_top_ch": 0.025,
        "max_width_cw": 0.76
      }
    },
    {
      "id": "ref_badge",
      "kind": "reference_badge",
      "visible": true,
      "properties": {
        "font_family": "Inter",
        "font_style": "Medium",
        "font_size_cw": 0.032,
        "text_color": "#F4EFE0",
        "opacity": 0.65,
        "position_relative_to": "translation",
        "margin_top_ch": 0.018
      }
    },
    {
      "id": "qari_pill",
      "kind": "reciter_pill",
      "visible": false,
      "properties": {
        "font_family": "Inter",
        "font_size_cw": 0.034,
        "text_color": "#FFFFFF",
        "background_color": "rgba(8, 9, 12, 0.55)",
        "border_radius_cw": 0.02,
        "padding_cw": [
          0.008,
          0.025
        ],
        "position_anchor": "bottom_center",
        "offset_y_ch": 0.26
      }
    }
  ],
  "animations": {
    "transition_in": {
      "type": "fade",
      "duration_ticks": 15360,
      "easing": "ease_out"
    },
    "transition_out": {
      "type": "fade",
      "duration_ticks": 9600,
      "easing": "ease_in"
    },
    "karaoke": {
      "transition_duration_ticks": 3840,
      "easing": "ease_out"
    }
  }
}
