{
  "$schema": "https://schema.quranrender.app/template/v1.json",
  "id": "modern",
  "version": "1.0.0",
  "name": "Modern Minimal",
  "description": "Desain tipografi kontemporer dengan garis batas tajam dan kontras tinggi.",
  "author": "QuranRender Team",
  "license": "CC0-1.0",
  "supported_ratios": ["9:16", "1:1", "16:9"],
  "default_ratio": "9:16",
  "safe_area": {
    "9:16": { "top": 0.08, "bottom": 0.14, "left": 0.10, "right": 0.10 },
    "1:1": { "top": 0.06, "bottom": 0.06, "left": 0.06, "right": 0.06 },
    "16:9": { "top": 0.08, "bottom": 0.08, "left": 0.08, "right": 0.08 }
  },
  "background": {
    "default_color": "#0B0F17",
    "dimmer_opacity": 0.30
  },
  "typography": {
    "ayah_font": "LPMQ IsepMisbah",
    "ayah_size_cw": 0.078,
    "ayah_color": "#F8FAFC",
    "translation_font": "Inter",
    "translation_size_cw": 0.040,
    "translation_color": "#94A3B8",
    "translation_opacity": 0.85,
    "highlight_style": "smooth_fade"
  }
}
