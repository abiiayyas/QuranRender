{
  "$schema": "https://schema.quranrender.app/template/v1.json",
  "id": "naskh",
  "version": "1.0.0",
  "name": "Naskh Klasik",
  "description": "Mushaf Madinah dengan garis batas bingkai hiasan klasik dan proporsi khat naskh tradisional.",
  "author": "QuranRender Team",
  "license": "CC0-1.0",
  "supported_ratios": ["9:16", "16:9", "4:5"],
  "default_ratio": "9:16",
  "safe_area": {
    "9:16": { "top": 0.08, "bottom": 0.14, "left": 0.10, "right": 0.10 },
    "16:9": { "top": 0.08, "bottom": 0.08, "left": 0.08, "right": 0.08 },
    "4:5": { "top": 0.06, "bottom": 0.08, "left": 0.06, "right": 0.06 }
  },
  "background": {
    "default_color": "#1C1917",
    "dimmer_opacity": 0.50
  },
  "typography": {
    "ayah_font": "Amiri",
    "ayah_size_cw": 0.080,
    "ayah_color": "#F5F5F4",
    "translation_font": "Inter",
    "translation_size_cw": 0.038,
    "translation_color": "#D6D3D1",
    "translation_opacity": 0.90,
    "highlight_style": "smooth_fade"
  }
}
