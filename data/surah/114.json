{"data":[{"aya_id":6231,"aya_number":1,"aya_text":"قُلْ اَعُوْذُ بِرَبِّ النَّاسِۙ","sura_id":114,"juz_id":30,"page_number":604,"translation_aya_text":"Katakanlah, “Aku berlindung kepada Tuhannya manusia,","translation_en":"SAY: \"I seek refuge with the Sustainer of men,"},{"aya_id":6232,"aya_number":2,"aya_text":"مَلِكِ النَّاسِۙ","sura_id":114,"juz_id":30,"page_number":604,"translation_aya_text":"Raja manusia,","translation_en":"\"the Sovereign of men,"},{"aya_id":6233,"aya_number":3,"aya_text":"اِلٰهِ النَّاسِۙ","sura_id":114,"juz_id":30,"page_number":604,"translation_aya_text":"sembahan manusia,","translation_en":"\"the God of men,"},{"aya_id":6234,"aya_number":4,"aya_text":"مِنْ شَرِّ الْوَسْوَاسِ ەۙ الْخَنَّاسِۖ","sura_id":114,"juz_id":30,"page_number":604,"translation_aya_text":"dari kejahatan (bisikan) setan yang bersembunyi,","translation_en":"\"from the evil of the whispering, elusive tempter"},{"aya_id":6235,"aya_number":5,"aya_text":"الَّذِيْ يُوَسْوِسُ فِيْ صُدُوْرِ النَّاسِۙ","sura_id":114,"juz_id":30,"page_number":604,"translation_aya_text":"yang membisikkan (kejahatan) ke dalam dada manusia,","translation_en":"\"who whispers in the hearts of men"},{"aya_id":6236,"aya_number":6,"aya_text":"مِنَ الْجِنَّةِ وَالنَّاسِ ࣖ ","sura_id":114,"juz_id":30,"page_number":604,"translation_aya_text":"dari (golongan) jin dan manusia.”","translation_en":"\"from all [temptation to evil by] invisible forces as well as men,\""}]}